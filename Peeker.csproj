<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <AssemblyName>Peeker</AssemblyName>
        <RootNamespace>Peeker</RootNamespace>

        <!-- Lethal Company installation -->
        <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</GameDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- BepInEx -->
        <Reference Include="BepInEx">
            <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Lethal Company -->
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.InputSystem">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\Unity.InputSystem.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="Unity.Netcode.Runtime">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\Unity.Netcode.Runtime.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine.PhysicsModule">
            <HintPath>$(GameDir)\Lethal Company_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- Automatically copy mod into BepInEx -->
    <Target Name="DeployMod" AfterTargets="Build">

        <MakeDir
                Directories="$(GameDir)\BepInEx\plugins\Peeker" />

        <Copy
                SourceFiles="$(TargetPath)"
                DestinationFolder="$(GameDir)\BepInEx\plugins\Peeker"
                SkipUnchangedFiles="true" />

    </Target>

</Project>